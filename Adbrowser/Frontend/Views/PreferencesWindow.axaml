<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Adbrowser.Frontend.Views.PreferencesWindow"
        Width="760"
        Height="560"
        MinWidth="640"
        MinHeight="460"
        mc:Ignorable="d"
        Title="{Binding Title}">
    <Grid Classes="window-surface">
        <Border Margin="12">
            <Grid RowDefinitions="*,Auto">
                <TabControl TabStripPlacement="Top">
                    <TabItem Header="{Binding GeneralTabTitle}">
                        <ScrollViewer>
                            <StackPanel Margin="0 10 0 5 " Spacing="10">
                                <Border Classes="panel-surface">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold" FontSize="14" />
                                        <ComboBox ItemsSource="{Binding Languages}"
                                                  SelectedItem="{Binding SelectedLanguage}"
                                                  HorizontalAlignment="Left"
                                                  Width="200" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="panel-surface">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding ResetOptionsSectionTitle}" FontWeight="SemiBold" FontSize="14" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{Binding ResetSidebarSpacingText}"
                                                    Command="{Binding ResetSidebarSpacingCommand}" />
                                            <Button Content="{Binding ResetFileColumnWidthsText}"
                                                    Command="{Binding ResetFileColumnWidthsCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding FilesTabTitle}">
                        <ScrollViewer>
                            <StackPanel Margin="0 10 0 5 " Spacing="10">
                                <Border Classes="panel-surface">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding FileListSectionTitle}" FontWeight="SemiBold" FontSize="14" />
                                        <CheckBox Content="{Binding ShowHiddenFilesLabel}"
                                                  IsChecked="{Binding ShowHiddenFiles}" />
                                        <CheckBox Content="{Binding FoldersFirstLabel}"
                                                  IsChecked="{Binding FoldersFirst}" />
                                        <CheckBox Content="{Binding RememberLastDisplayStyleLabel}"
                                                  IsChecked="{Binding RememberLastDisplayStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding DeviceTabTitle}">
                        <ScrollViewer>
                            <StackPanel Margin="0 10 0 5 " Spacing="10">
                                <Border Classes="panel-surface">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding EnvironmentSectionTitle}" FontWeight="SemiBold" FontSize="14" />
                                        <Grid ColumnDefinitions="Auto, *" VerticalAlignment="Center">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding AdbPathLabel}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,12,0" />
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding AdbPath}"
                                                     Watermark="{Binding AdbPathWatermark}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="panel-surface">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{Binding ConnectionSectionTitle}" FontWeight="SemiBold" FontSize="14" />
                                        <CheckBox Content="{Binding SuperuserLabel}"
                                                  IsChecked="{Binding Superuser}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,8,8" Spacing="12">
                    <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" Opacity="0.6" Margin="0,0,10,0" />
                    <Button Content="{Binding CancelText}"
                            Command="{Binding CancelCommand}"
                            Width="80" HorizontalContentAlignment="Center" />
                    <Button Content="{Binding SaveText}"
                            Classes="primary"
                            Command="{Binding SaveCommand}"
                            Width="80" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>