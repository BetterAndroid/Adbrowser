<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Adbrowser.Frontend.ViewModels"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        x:Class="Adbrowser.Frontend.Views.MainWindow"
        Width="1300"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        mc:Ignorable="d"
        Title="{Binding Title}">
    <Window.Resources>
        <ResourceDictionary>
            <x:Double x:Key="DevicePaneMinWidth">240</x:Double>
            <x:Double x:Key="FilePaneMinWidth">560</x:Double>
            <GridLength x:Key="FileColNameWidth">360</GridLength>
            <GridLength x:Key="FileColSizeWidth">140</GridLength>
            <GridLength x:Key="FileColModifiedWidth">240</GridLength>
            <GridLength x:Key="FileColPermissionWidth">150</GridLength>
            <SolidColorBrush x:Key="PathBreadcrumbForegroundBrush" Color="{DynamicResource PathBreadcrumbForegroundColor}" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:String x:Key="FileIconStrokeCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#2E6CD3;}</x:String>
                    <x:String x:Key="FileListHintIconStrokeCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#97B6E9;}</x:String>
                    <Color x:Key="FileListHintForegroundColor">#97B6E9</Color>
                    <Color x:Key="PathBreadcrumbForegroundColor">#6B7280</Color>
                    <x:String x:Key="PathBreadcrumbIconCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#6B7280;fill:#6B7280;}</x:String>
                    <x:String x:Key="NavButtonIconCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#334155;fill:none;}</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:String x:Key="FileIconStrokeCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#4D8FF6;}</x:String>
                    <x:String x:Key="FileListHintIconStrokeCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#27487B;}</x:String>
                    <Color x:Key="FileListHintForegroundColor">#27487B</Color>
                    <Color x:Key="PathBreadcrumbForegroundColor">#9CA3AF</Color>
                    <x:String x:Key="PathBreadcrumbIconCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#9CA3AF;fill:#9CA3AF;}</x:String>
                    <x:String x:Key="NavButtonIconCss">path,rect,circle,ellipse,polygon,polyline,line{stroke:#D1D5DB;fill:none;}</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ListBox ListBoxItem">
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox#DevicesListBox ListBoxItem:first-child, ListBox#FilesListBox ListBoxItem:first-child">
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>
        <Style Selector="ListBox#DevicesListBox ListBoxItem:last-child, ListBox#FilesListBox ListBoxItem:last-child">
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>
        <Style Selector="ListBox#DevicesListBox ListBoxItem:first-child:last-child, ListBox#FilesListBox ListBoxItem:first-child:last-child">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style
            Selector="ListBox#DevicesListBox ListBoxItem:first-child /template/ ContentPresenter#PART_ContentPresenter, ListBox#FilesListBox ListBoxItem:first-child /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>
        <Style
            Selector="ListBox#DevicesListBox ListBoxItem:last-child /template/ ContentPresenter#PART_ContentPresenter, ListBox#FilesListBox ListBoxItem:last-child /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>
        <Style
            Selector="ListBox#DevicesListBox ListBoxItem:first-child:last-child /template/ ContentPresenter#PART_ContentPresenter, ListBox#FilesListBox ListBoxItem:first-child:last-child /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="svg|Svg.file-icon">
            <Setter Property="Css" Value="{DynamicResource FileIconStrokeCss}" />
        </Style>
        <Style Selector="Button.nav-btn svg|Svg.nav-icon">
            <Setter Property="Css" Value="{DynamicResource NavButtonIconCss}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected svg|Svg.file-icon">
            <Setter Property="Css" Value="path,rect,circle,ellipse,polygon,polyline,line{stroke:#FFFFFF;}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentHoverBrush}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource PrimaryAccentPressedBrush}" />
        </Style>
        <Style Selector="GridSplitter.file-col-splitter">
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="ZIndex" Value="20" />
        </Style>
        <Style Selector="GridSplitter.file-col-splitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
        </Style>
        <Style Selector="GridSplitter.pane-splitter">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="#01000000" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="ZIndex" Value="20" />
        </Style>
        <Style Selector="GridSplitter.pane-splitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}" />
        </Style>
        <Style Selector="ScrollViewer.path-breadcrumb-scroll ScrollBar:horizontal">
            <Setter Property="Height" Value="4" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="ScrollViewer.path-breadcrumb-scroll ScrollBar:horizontal Thumb">
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource HintBorderBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource MainBackgroundBrush}">
        <Border Classes="menu-host" Grid.Row="0">
            <Menu Classes="main-menu">
                <MenuItem Header="{Binding MenuFile}">
                    <MenuItem Header="{Binding MenuNewFolder}" Click="OnNewFolderClick" />
                    <Separator />
                    <MenuItem Header="{Binding MenuRename}" Click="OnRenameClick" />
                    <MenuItem Header="{Binding MenuDelete}" Click="OnDeleteClick" />
                    <MenuItem Header="{Binding MenuProperties}" Click="OnPropertiesClick" />
                    <Separator />
                    <MenuItem Header="{Binding MenuPreferences}" Click="OnPreferencesClick" />
                    <MenuItem Header="{Binding MenuExit}" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="{Binding MenuEdit}">
                    <MenuItem Header="{Binding MenuCut}" Click="OnCutClick" />
                    <MenuItem Header="{Binding MenuCopy}" Click="OnCopyClick" />
                    <MenuItem Header="{Binding MenuPaste}" Click="OnPasteClick" />
                    <Separator />
                    <MenuItem Header="{Binding MenuSelectAll}" />
                    <MenuItem Header="{Binding MenuInverseSelect}" />
                </MenuItem>
                <MenuItem Header="{Binding MenuView}">
                    <MenuItem Header="{Binding MenuRefresh}" Command="{Binding RefreshEntriesCommand}" />
                    <MenuItem Header="{Binding MenuViewMode}" />
                    <MenuItem Header="{Binding MenuSortMode}" />
                    <Separator />
                    <MenuItem Header="{Binding MenuToggleStatusBarDynamic}" Command="{Binding ToggleStatusBarCommand}" />
                    <MenuItem Header="{Binding MenuAdbLogs}" Click="OnLogsClick" />
                    <MenuItem Header="{Binding MenuAppLogs}" Click="OnLogsClick" />
                </MenuItem>
                <MenuItem Header="{Binding MenuGo}">
                    <MenuItem Header="{Binding MenuForward}" Command="{Binding NavigateForwardCommand}" />
                    <MenuItem Header="{Binding MenuBack}" Command="{Binding NavigateBackCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding MenuUp}" Command="{Binding NavigateUpCommand}" />
                    <MenuItem Header="{Binding MenuRoot}" Command="{Binding NavigateRootCommand}" />
                    <MenuItem Header="{Binding MenuHome}" Command="{Binding NavigateHomeCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding MenuSearch}" Command="{Binding SearchCommand}" />
                </MenuItem>
                <MenuItem Header="{Binding MenuHelp}">
                    <MenuItem Header="{Binding MenuComingSoon}" IsEnabled="False" />
                </MenuItem>
            </Menu>
        </Border>

        <Grid x:Name="MainLayoutGrid" Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="{StaticResource DevicePaneMinWidth}" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="{StaticResource FilePaneMinWidth}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Classes="sidebar" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Text="{Binding DevicesTitle}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="nav-btn"
                                VerticalAlignment="Center"
                                Command="{Binding RefreshDevicesCommand}">
                            <svg:Svg Classes="nav-icon"
                                     Width="16"
                                     Height="16"
                                     Path="avares://Adbrowser/Frontend/Assets/Icons/Refresh.svg"
                                     Stretch="Uniform" />
                        </Button>
                    </Grid>
                    <ListBox x:Name="DevicesListBox"
                             Grid.Row="1"
                             ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AndroidDeviceItem">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Model}" Opacity="0.78" FontSize="12" />
                                    <TextBlock Grid.Row="2" Text="{Binding Serial}" Opacity="0.75" FontSize="11" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Classes="pane-splitter"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False" />

            <Border Grid.Column="2" Classes="content-pane" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
                        <Button Grid.Column="0" Classes="nav-btn" Command="{Binding NavigateBackCommand}">
                            <svg:Svg Classes="nav-icon"
                                     Width="16"
                                     Height="16"
                                     Path="avares://Adbrowser/Frontend/Assets/Icons/ArrowLeft.svg"
                                     Stretch="Uniform" />
                        </Button>
                        <Button Grid.Column="1" Classes="nav-btn" Margin="6,0,0,0" Command="{Binding NavigateForwardCommand}">
                            <svg:Svg Classes="nav-icon"
                                     Width="16"
                                     Height="16"
                                     Path="avares://Adbrowser/Frontend/Assets/Icons/ArrowRight.svg"
                                     Stretch="Uniform" />
                        </Button>
                        <Button Grid.Column="2" Classes="nav-btn" Margin="6,0,0,0" Command="{Binding NavigateUpCommand}">
                            <svg:Svg Classes="nav-icon"
                                     Width="16"
                                     Height="16"
                                     Path="avares://Adbrowser/Frontend/Assets/Icons/ArrowUp.svg"
                                     Stretch="Uniform" />
                        </Button>
                        <Button Grid.Column="3" Classes="nav-btn" Margin="6,0,0,0" Command="{Binding NavigateHomeCommand}">
                            <svg:Svg Classes="nav-icon"
                                     Width="16"
                                     Height="16"
                                     Path="avares://Adbrowser/Frontend/Assets/Icons/Home.svg"
                                     Stretch="Uniform" />
                        </Button>
                        <TextBox Grid.Column="4"
                                 Margin="10,0,10,0"
                                 Text="{Binding PathInput}"
                                 KeyDown="OnPathInputKeyDown" />
                        <ComboBox Grid.Column="5" Width="110" ItemsSource="{Binding ViewModes}" SelectedItem="{Binding SelectedViewMode}" />
                        <ComboBox Grid.Column="6" Width="130" Margin="8,0,0,0" ItemsSource="{Binding SortModes}"
                                  SelectedItem="{Binding SelectedSortMode}" />
                    </Grid>

                    <Border Grid.Row="1" Classes="file-list-container" PointerPressed="OnFilePanePointerPressed">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid RowDefinitions="Auto,*">
                                    <Border Grid.Row="0"
                                            Margin="1,1,1,0"
                                            Background="{DynamicResource SubtleControlBackgroundBrush}"
                                            CornerRadius="7,7,0,0">
                                        <Grid x:Name="FileHeaderGrid" Classes="file-header">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="360" MinWidth="180" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="140" MinWidth="90" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="240" MinWidth="150" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="150" MinWidth="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding HeaderName}" />
                                            <GridSplitter Grid.Column="1"
                                                          Classes="file-col-splitter"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          ShowsPreview="False" />
                                            <TextBlock Grid.Column="2" Text="{Binding HeaderSize}" />
                                            <GridSplitter Grid.Column="3"
                                                          Classes="file-col-splitter"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          ShowsPreview="False" />
                                            <TextBlock Grid.Column="4" Text="{Binding HeaderModified}" />
                                            <GridSplitter Grid.Column="5"
                                                          Classes="file-col-splitter"
                                                          ResizeDirection="Columns"
                                                          ResizeBehavior="PreviousAndNext"
                                                          ShowsPreview="False" />
                                            <TextBlock Grid.Column="6" Text="{Binding HeaderPermission}" />
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <ListBox x:Name="FilesListBox"
                                                 ItemsSource="{Binding CurrentEntries}"
                                                 SelectedItem="{Binding SelectedEntry}"
                                                 DoubleTapped="OnEntryDoubleTapped"
                                                 DragDrop.AllowDrop="True"
                                                 DragDrop.Drop="OnFilePaneDrop">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{Binding MenuRefresh}" Command="{Binding RefreshEntriesCommand}" />
                                                    <MenuItem Header="{Binding MenuNewFolder}" Click="OnNewFolderClick" />
                                                    <MenuItem Header="{Binding MenuRename}" Click="OnRenameClick" />
                                                    <MenuItem Header="{Binding MenuCopy}" Click="OnCopyClick" />
                                                    <MenuItem Header="{Binding MenuCut}" Click="OnCutClick" />
                                                    <MenuItem Header="{Binding MenuPaste}" Click="OnPasteClick" />
                                                    <MenuItem Header="{Binding MenuDelete}" Click="OnDeleteClick" />
                                                    <MenuItem Header="{Binding MenuProperties}" Click="OnPropertiesClick" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:DeviceFileItem">
                                                    <Border Classes="file-row">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{DynamicResource FileColNameWidth}" MinWidth="180" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="{DynamicResource FileColSizeWidth}" MinWidth="90" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="{DynamicResource FileColModifiedWidth}" MinWidth="150" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="{DynamicResource FileColPermissionWidth}" MinWidth="110" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10" ClipToBounds="True">
                                                                <svg:Svg Grid.Column="0"
                                                                         Width="16"
                                                                         Height="16"
                                                                         VerticalAlignment="Center"
                                                                         Classes="file-icon"
                                                                         Path="{Binding IconUri}"
                                                                         Stretch="Uniform" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding DisplayName}"
                                                                           FontSize="14"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding SizeText}"
                                                                       FontSize="14"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ClipToBounds="True" />
                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding ModifiedText}"
                                                                       FontSize="14"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ClipToBounds="True" />
                                                            <TextBlock Grid.Column="6"
                                                                       Text="{Binding Permission}"
                                                                       FontSize="14"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ClipToBounds="True" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel IsVisible="{Binding IsFileListHintVisible}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Spacing="10"
                                                    IsHitTestVisible="False">
                                            <svg:Svg Width="80"
                                                     Height="80"
                                                     Path="avares://Adbrowser/Frontend/Assets/Icons/Folder.svg"
                                                     Stretch="Uniform"
                                                     Css="{DynamicResource FileListHintIconStrokeCss}" />
                                            <TextBlock Text="{Binding FileListHintMessage}"
                                                       Foreground="{DynamicResource FileListHintForegroundColor}"
                                                       FontSize="16"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" Classes="status-bar path-breadcrumb-bar" Padding="12,6" Margin="0">
                        <ScrollViewer Classes="path-breadcrumb-scroll"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Tag="/"
                                        Click="OnPathBreadcrumbClick"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        MinWidth="0"
                                        MinHeight="0"
                                        Opacity="0.75">
                                    <svg:Svg Width="14"
                                             Height="14"
                                             Path="avares://Adbrowser/Frontend/Assets/Icons/FilePathArrow.svg"
                                             Stretch="Uniform"
                                             Css="{DynamicResource PathBreadcrumbIconCss}" />
                                </Button>

                                <ItemsControl ItemsSource="{Binding PathBreadcrumbSegments}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        VerticalAlignment="Center"
                                                        Opacity="0.75">
                                                <svg:Svg Width="14"
                                                         Height="14"
                                                         IsVisible="{Binding ShowLeadingArrow}"
                                                         Path="avares://Adbrowser/Frontend/Assets/Icons/FilePathArrow.svg"
                                                         Stretch="Uniform"
                                                         Css="{DynamicResource PathBreadcrumbIconCss}" />
                                                <Button Tag="{Binding FullPath}"
                                                        Click="OnPathBreadcrumbClick"
                                                        IsVisible="{Binding ShowName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        MinWidth="0"
                                                        MinHeight="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource PathBreadcrumbForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Classes="status-bar" Padding="12,6" IsVisible="{Binding IsStatusBarVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CommitIdText}"
                           VerticalAlignment="Center"
                           Foreground="#8A8A8A"
                           FontSize="12"
                           TextAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>